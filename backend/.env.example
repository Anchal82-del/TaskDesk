# Copy this file to ".env" and adjust. ".env" is git-ignored, so secrets never reach GitHub.
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
# Comma-separated list of front-end addresses allowed to call the API (CORS whitelist).
CORS_ORIGINS=http://localhost:4200
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
